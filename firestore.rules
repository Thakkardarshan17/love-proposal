rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /proposals/{proposalId} {
      allow read, write: if true;
    }
    match /proposals/{proposalId}/{allSubcollections=**} {
      allow read, write: if true;
    }
    match /love_chat_messages/{messageId} {
      allow read, write: if true;
    }
  }
}

